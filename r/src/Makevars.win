PKG_CPPFLAGS = $(shell $(R_HOME)/bin/Rscript -e "RcppArmadillo:::CxxFlags()") -I../../core/src -DUSING_R
PKG_CXXFLAGS = -std=c++17

PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

RCPP_PARALLEL_CXXFLAGS := $(shell $(R_HOME)/bin/Rscript -e "RcppParallel::CxxFlags()")
RCPP_PARALLEL_LIBS     := $(shell $(R_HOME)/bin/Rscript -e "RcppParallel::RcppParallelLibs()")
PKG_CPPFLAGS += $(RCPP_PARALLEL_CXXFLAGS) -DAPM_HAS_TBB=1
PKG_LIBS     += $(RCPP_PARALLEL_LIBS)
$(info APM: Building with oneTBB via RcppParallel on Windows)
$(info APM: RCPP_PARALLEL_CXXFLAGS=$(RCPP_PARALLEL_CXXFLAGS))
$(info APM: RCPP_PARALLEL_LIBS=$(RCPP_PARALLEL_LIBS))

OBJECTS = apm_core_bindings.o bootstrap_bindings.o r_utils.o RcppExports.o \
           ../../core/src/apm_core.o ../../core/src/linear_algebra_utils.o ../../core/src/bootstrap.o ../../core/src/online_accumulators.o \
           ../../core/src/factor_model_estimators/FactorModelEstimator.o ../../core/src/factor_model_estimators/pc_estimators.o \
           ../../core/src/factor_model_estimators/twfe_estimator.o \
           ../../core/src/OutcomeMeanSuffStatEstimator.o ../../core/src/nuisance_param_estimators.o ../../core/src/est_cohort_specific_params.o \
           ../../core/src/panels/InMemoryUnbalancedPanel.o ../../core/src/panels/CohortLevelUnbalancedPanel.o \
           ../../core/src/utils.o ../../core/src/est_outcome_means.o ../../core/src/agg_cohort_specific_factor_model_params.o ../../core/src/target_params/est_target_params.o ../../core/src/outcome_imputation.o \
           factor_model_estimator_bindings.o pc_estimator_bindings.o outcome_mean_suff_stats_bindings.o \
           twfe_estimator_bindings.o \
           est_cohort_specific_params_bindings.o cohort_weight_estimates_bindings.o nuisance_params_bindings.o \
           est_outcome_means_bindings.o agg_cohort_specific_factor_model_params_bindings.o outcome_means_estimates_bindings.o est_target_params_bindings.o \
           outcome_imputation_bindings.o \
           outcome_clustering_bindings.o ../../core/src/outcome_clustering/cluster_outcomes.o \
           ../../core/src/outcome_clustering/weighted_kmeans.o \
           summarize_identification_bindings.o ../../core/src/summarize_identification.o
