# Makevars for apm R package
# This tells R how to compile and link the core C++ library

# Use RcppArmadillo flags for consistent compilation and define USING_R flag
PKG_CPPFLAGS = $(shell $(R_HOME)/bin/Rscript -e "RcppArmadillo:::CxxFlags()") -I../../core/src -DUSING_R -I/opt/homebrew/include
PKG_CXXFLAGS = -std=c++17

# RcppArmadillo is header-only, no special linking needed. Add Boost lib path.
PKG_LIBS = -L/opt/homebrew/lib $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

# Object files (including the core library)
OBJECTS = apm_core_bindings.o bootstrap_bindings.o r_utils.o RcppExports.o \
           ../../core/src/apm_core.o ../../core/src/linear_algebra_utils.o ../../core/src/bootstrap.o \
           ../../core/src/factor_model_estimators/FactorModelEstimator.o ../../core/src/factor_model_estimators/pc_estimators.o \
           ../../core/src/OutcomeMeanSuffStatEstimator.o ../../core/src/nuisance_param_estimators.o ../../core/src/est_cohort_specific_params.o \
           ../../core/src/utils.o ../../core/src/est_outcome_means.o \
           factor_model_estimator_bindings.o pc_estimator_bindings.o outcome_mean_suff_stats_bindings.o \
           est_cohort_specific_params_bindings.o cohort_weight_estimates_bindings.o nuisance_params_bindings.o \
           est_outcome_means_bindings.o outcome_means_estimates_bindings.o